{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@loopback/build/config/tsconfig.common.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "paths": {
      "express": ["./node_modules/@types/express"],
      "express-serve-static-core": [
        "./node_modules/@types/express-serve-static-core"
      ]
    }
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../core/tsconfig.json"
    },
    {
      "path": "../express/tsconfig.json"
    },
    {
      "path": "../http-server/tsconfig.json"
    },
    {
      "path": "../openapi-spec-builder/tsconfig.json"
    },
    {
      "path": "../openapi-v3/tsconfig.json"
    },
    {
      "path": "../repository/tsconfig.json"
    },
    {
      "path": "../testlab/tsconfig.json"
    }
  ]
}
